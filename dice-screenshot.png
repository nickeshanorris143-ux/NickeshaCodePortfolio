<!DOCTYPE html>
<!--
Color Changing Dice
Returns a random number from 1 to 6 and changes the dice color.
By: Nickesha Norris, inspired by Jenell Baxter
-->

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Color Changing Dice</title>
</head>
<body>
    <h1>Color Changing Dice</h1>

    <div class="container">
        <div class="dice" id="dice">
            <p id="result"></p>
        </div>
    </div>

    <button id="rollButton">Roll Dice</button>

    <script src="diceRoll.js"></script>
</body>
</html>
